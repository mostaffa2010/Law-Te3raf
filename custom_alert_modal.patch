diff --git a/style.css b/style.css
--- a/style.css
+++ b/style.css
@@ -628,3 +628,49 @@
 @keyframes spin { to { transform: rotate(360deg); } }
 @keyframes popIn { 0% { transform: scale(0.7); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
 @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
+
+/* نافذة التنبيه المخصصة Custom Alert Modal */
+.custom-modal-overlay {
+    position: fixed;
+    top: 0;
+    left: 0;
+    width: 100vw;
+    height: 100vh;
+    background: rgba(0, 0, 0, 0.75);
+    backdrop-filter: blur(8px);
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    z-index: 999999;
+    opacity: 0;
+    visibility: hidden;
+    transition: opacity 0.25s ease, visibility 0.25s ease;
+}
+.custom-modal-overlay.show {
+    opacity: 1;
+    visibility: visible;
+}
+.custom-modal-card {
+    background: var(--bg-card);
+    border: 1px solid var(--accent-purple);
+    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6);
+    border-radius: 22px;
+    padding: 25px 20px;
+    max-width: 320px;
+    width: 90%;
+    text-align: center;
+    transform: scale(0.85);
+    transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
+}
+.custom-modal-overlay.show .custom-modal-card { transform: scale(1); }
+.custom-modal-icon { font-size: 40px; margin-bottom: 10px; }
+.custom-modal-card h3 { font-size: 1.2rem; margin-bottom: 8px; }
+.custom-modal-card p { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 20px; }
+.btn-modal-close {
+    background: linear-gradient(135deg, var(--accent-yellow), #d97706);
+    color: #000;
+    border: none;
+    width: 100%;
+    padding: 12px;
+    border-radius: 14px;
+    font-weight: 800;
+    font-size: 1rem;
+    cursor: pointer;
+}
